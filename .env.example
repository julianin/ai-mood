# Server-side fallback key (optional, for development only). Never expose in frontend.
POLLINATIONS_API_KEY=sk_your_dev_or_fallback_key_here

# Public BYOP App Key. Create one at enter.pollinations.ai
POLLINATIONS_APP_KEY=pk_your_publishable_app_key_here

# Pollinations API endpoints
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_AUTH_BASE_URL=https://enter.pollinations.ai

# Model configuration
POLLINATIONS_GENERATE_MODEL=flux
POLLINATIONS_EDIT_MODEL=kontext
POLLINATIONS_MOOD_MODEL=openai

# Image settings
IMAGE_SIZE=768x768
IMAGE_QUALITY=medium
REFERENCE_MODE=base

# BYOP settings
BYOP_REDIRECT_PATH=/auth/callback
BYOP_SCOPE=usage
BYOP_BUDGET=5
BYOP_EXPIRY_DAYS=7
